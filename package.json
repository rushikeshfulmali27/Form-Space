{
  "name": "form-object-studio",
  "version": "1.6.0",
  "private": true,
  "description": "Browser-only parametric 3D object customization demo",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "node scripts/check-syntax.mjs",
    "check:secrets": "node scripts/check-secrets.mjs && node scripts/check-secrets.mjs --build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
